# ==============================================================================
# Access & User Management System - Environment Variables Template
# Copy this file to .env on your production server:
# cp .env.example .env
# ==============================================================================

# Application Security
# Generate a secure key using: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-very-long-and-secure-random-secret-key-in-production

# PostgreSQL Database Configuration
POSTGRES_USER=hospital_user
POSTGRES_PASSWORD=change-this-to-a-strong-postgres-password
POSTGRES_DB=hospital_db
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432

# Production Domain & HTTPS Security
# Set COOKIE_SECURE=true when running behind HTTPS/SSL
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Frontend API URL
# When served through Nginx reverse proxy, /api/v1 is recommended
VITE_API_URL=/api/v1

# Seeding initial users (Set to true only on first deployment)
RUN_SEEDS=false
