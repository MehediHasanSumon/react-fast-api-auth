PROJECT_NAME=Access & User Management API
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hospital_db
# Or specify full connection string directly:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hospital_db

# SMTP Email Configuration (Leave SMTP_HOST empty for local console simulation)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Access Portal"
SMTP_TLS=True
SMTP_SSL=False

# Frontend URL
FRONTEND_URL=http://localhost:5173

