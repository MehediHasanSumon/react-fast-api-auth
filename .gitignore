# ==============================================================================
# Hospital Management System - Root .gitignore
# ==============================================================================

# Operating System & Editors
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.bak

# Environment Variables & Secrets (Keep .env.example)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/.env.local
*.local

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
ENV/
backend/venv/

# Node.js & Frontend Build
node_modules/
frontend/node_modules/
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
.vite/
frontend/.vite/
coverage/
*.lcov

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Databases & SQLite
*.sqlite
*.sqlite3
*.db

# Uploads
uploads/
backend/uploads/
!backend/uploads/.gitkeep
!backend/uploads/avatars/.gitkeep
